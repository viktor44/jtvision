<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC
		"-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
		"https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
	<property name="charset" value="UTF-8" />
	<property name="fileExtensions" value="java" />

	<module name="Header">
		<property name="fileExtensions" value="java" />
		<property name="header" value="/*\n * SPDX-License-Identifier: Apache-2.0\n * Copyright 2026-present Viktor44\n */\n" />
	</module>		

	<module name="NewlineAtEndOfFile" />
<!--  
	<module name="LineEnding">
		<property name="lineEnding" value="lf" />
	</module>
-->
	<module name="TreeWalker">
		<module name="AvoidStarImport" />
		
		<!-- Checks for the placement of left curly braces ('{') for code blocks. -->
		<module name="LeftCurly" />
		
		<!-- Checks the placement of right curly braces ('}') for code blocks. -->
		<module name="RightCurly">
      		<property name="option" value="alone" />
      		<property name="tokens" value="LITERAL_TRY, LITERAL_CATCH, LITERAL_FINALLY, LITERAL_IF, LITERAL_ELSE, LITERAL_WHILE, LITERAL_DO" />
      	</module>
      	
		<!-- Checks for braces around code blocks. -->
		<module name="NeedBraces" />
		
		<!-- Checks for empty line separators after, fields, constructors, methods, nested classes, static initializers and instance initializers. -->	
		<module name="EmptyLineSeparator">
			<property name="allowNoEmptyLineBetweenFields" value="true" />
			<property name="tokens" value="IMPORT, STATIC_IMPORT, CLASS_DEF, INTERFACE_DEF, ENUM_DEF, STATIC_INIT, INSTANCE_INIT, METHOD_DEF, CTOR_DEF, VARIABLE_DEF, RECORD_DEF, COMPACT_CTOR_DEF"/>
      	</module>

		<module name="NoWhitespaceBeforeCaseDefaultColon" />

		<module name="HiddenField">
			<property name="ignoreConstructorParameter" value="true" />
			<property name="ignoreSetter" value="true" />
		</module>
	</module>

</module>
